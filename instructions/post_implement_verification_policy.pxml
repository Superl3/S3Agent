<?xml version="1.0" encoding="UTF-8"?>
<pxml xmlns="urn:pxml:v1">
  <meta>
    <doc_id>doc_post_impl_verify_policy_b6_001</doc_id>
    <doc_class>post_implement_verification_policy</doc_class>
    <schema_version>1.0.0</schema_version>
    <task_id>task_harness_batch6_executor_policy</task_id>
    <run_id>run_batch6_policies_001</run_id>
    <sequence>1</sequence>
    <writer_agent>manager</writer_agent>
    <created_at>2026-03-22T06:00:00Z</created_at>
  </meta>
  <refs>
    <ref>
      <doc_id>doc_retry_policy_batch4_001</doc_id>
      <doc_class>retry_policy</doc_class>
      <relation>companion_policy</relation>
    </ref>
    <ref>
      <doc_id>doc_escalation_policy_batch4_001</doc_id>
      <doc_class>escalation_policy</doc_class>
      <relation>companion_policy</relation>
    </ref>
  </refs>
  <payload>
    <rules>
      <rule>
        <policy_id>POST-VERIFY-001</policy_id>
        <rule_name>auto_verify_on_result_status</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>implementer_result</item>
        </applies_to>
        <trigger_condition>evaluate_result_status_matrix_after_implementer</trigger_condition>
        <decision>defer_verifier</decision>
        <rationale>Result status is the first gate; explicit status rules can override this default decision.</rationale>
        <enforcement_level>hard</enforcement_level>
      </rule>
      <rule>
        <policy_id>POST-VERIFY-002</policy_id>
        <rule_name>auto_verify_required_lane</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>selected_path</item>
        </applies_to>
        <trigger_condition>selected_path_in_verifier_post_or_full_lane</trigger_condition>
        <decision>run_verifier</decision>
        <rationale>Verifier-required lanes should run post-implement verification by default.</rationale>
        <enforcement_level>hard</enforcement_level>
      </rule>
      <rule>
        <policy_id>POST-VERIFY-003</policy_id>
        <rule_name>skip_verify_on_blocked</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>result_status_blocked</item>
        </applies_to>
        <trigger_condition>implementer_result_status_is_blocked</trigger_condition>
        <decision>skip_verifier</decision>
        <rationale>Blocked execution has no patch output to verify; next action is packet or scope correction.</rationale>
        <enforcement_level>hard</enforcement_level>
      </rule>
      <rule>
        <policy_id>POST-VERIFY-004</policy_id>
        <rule_name>skip_verify_on_retry_failed</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>result_status_retry_failed</item>
        </applies_to>
        <trigger_condition>implementer_result_status_is_retry_failed</trigger_condition>
        <decision>skip_verifier</decision>
        <rationale>Retry-failed execution escalates instead of consuming verifier budget.</rationale>
        <enforcement_level>hard</enforcement_level>
      </rule>
      <rule>
        <policy_id>POST-VERIFY-005</policy_id>
        <rule_name>skip_verify_on_escalated</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>result_status_escalated</item>
        </applies_to>
        <trigger_condition>implementer_result_status_is_escalated</trigger_condition>
        <decision>skip_verifier</decision>
        <rationale>Escalated execution must wait for human decision before additional verifier actions.</rationale>
        <enforcement_level>hard</enforcement_level>
      </rule>
      <rule>
        <policy_id>POST-VERIFY-006</policy_id>
        <rule_name>verify_on_no_op</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>result_status_no_op</item>
        </applies_to>
        <trigger_condition>implementer_result_status_is_no_op</trigger_condition>
        <decision>defer_verifier</decision>
        <rationale>No-op can defer verifier unless operator overrides to force confirmation evidence.</rationale>
        <enforcement_level>soft</enforcement_level>
      </rule>
      <rule>
        <policy_id>POST-VERIFY-007</policy_id>
        <rule_name>verify_on_applied</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>result_status_applied</item>
        </applies_to>
        <trigger_condition>implementer_result_status_is_applied</trigger_condition>
        <decision>run_verifier</decision>
        <rationale>Applied patch should normally produce post-implement verification evidence.</rationale>
        <enforcement_level>hard</enforcement_level>
      </rule>
      <rule>
        <policy_id>POST-VERIFY-008</policy_id>
        <rule_name>human_override_allowed</rule_name>
        <applies_to>
          <item>task_executor</item>
          <item>operator_override</item>
        </applies_to>
        <trigger_condition>verify_policy_override_flag_is_present</trigger_condition>
        <decision>require_human_decision</decision>
        <rationale>Operator may force always or never verify modes while preserving auditability.</rationale>
        <enforcement_level>advisory</enforcement_level>
      </rule>
    </rules>
  </payload>
  <integrity>
    <content_sha256>5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a</content_sha256>
  </integrity>
</pxml>
