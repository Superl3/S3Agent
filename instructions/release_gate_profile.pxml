      <item>task_impl_feature_direct_001</item>
      <item>task_verify_post_smoke_001</item>
    </coverage_task_ids>
    <candidate_gate_task_ids>
      <item>task_impl_feature_direct_001</item>
      <item>task_verify_post_smoke_001</item>
    </candidate_gate_task_ids>
    <allow_caution_rc>true</allow_caution_rc>
    <required_lane_coverage>
      <item>direct</item>
      <item>verifier_post</item>
    </required_lane_coverage>
    <required_ready_cases>1</required_ready_cases>
    <required_pruning_branches>
      <item>quarantine_first</item>
      <item>delete_derived_safe</item>
    </required_pruning_branches>
    <required_release_artifacts>
      <item>task_status_report</item>
      <item>operator_preflight_report</item>
