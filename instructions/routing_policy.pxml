<?xml version="1.0" encoding="UTF-8"?>
<pxml xmlns="urn:pxml:v1">
  <meta>
    <doc_id>doc_routing_policy_batch2_001</doc_id>
    <doc_class>routing_policy</doc_class>
    <schema_version>1.0.0</schema_version>
    <task_id>task_harness_batch2_policies</task_id>
    <run_id>run_batch2_policies_001</run_id>
    <sequence>1</sequence>
    <writer_agent>manager</writer_agent>
    <created_at>2026-03-22T00:12:00Z</created_at>
  </meta>
  <refs>
    <ref>
      <doc_id>doc_execution_policy_batch2_001</doc_id>
      <doc_class>execution_policy</doc_class>
      <relation>companion_policy</relation>
    </ref>
  </refs>
  <payload>
    <default_path>direct</default_path>
    <minimal_complexity_first>true</minimal_complexity_first>
    <decision_basis>
      <item>structured intake signal evaluation</item>
      <item>planning_mode classification</item>
      <item>execution_shape selection</item>
      <item>risk_level</item>
      <item>task ambiguity</item>
      <item>explicit verification need</item>
      <item>write_intent classification</item>
      <item>active sidecars are limited to planner and verifier; reviewer remains dormant.</item>
      <item>UI bugfix routing preserves root-cause-first sequencing before symptom-level mitigation packets are issued.</item>
      <item>When duplicate or competing UI paths exist, manager_route must carry declared UI state-path SSOT.</item>
      <item>If symptom-level patching is selected, acceptance lock must include state-path consistency proof checks.</item>
    </decision_basis>
    <paths>
      <path>
        <path_id>direct</path_id>
        <entry_condition>
          <item>Risk low or medium.</item>
          <item>Task intake request and outcome are clear.</item>
        </entry_condition>
        <reject_condition>
          <item>High ambiguity requiring decomposition.</item>
          <item>Critical risk requiring full lane controls.</item>
        </reject_condition>
        <escalation_condition>
          <item>Implementer reports blocked due to out_of_scope conflict.</item>
        </escalation_condition>
        <stop_condition>
          <item>Execution packet issued and accepted by Implementer.</item>
          <item>write_intent=false packet routed to exploration handoff without implementer call.</item>
          <item>Escalation emitted.</item>
        </stop_condition>
        <required_artifacts>
          <item>task_intake</item>
          <item>manager_route</item>
          <item>execution_packet</item>
        </required_artifacts>
      </path>
      <path>
        <path_id>planner_pre</path_id>
        <entry_condition>
          <item>Input ambiguity prevents deterministic in_scope extraction.</item>
          <item>Risk is not critical but assumptions are unresolved.</item>
        </entry_condition>
        <reject_condition>
          <item>Task already clear and low-risk with direct eligibility.</item>
        </reject_condition>
        <escalation_condition>
          <item>Planner output missing required assumptions and risk map.</item>
        </escalation_condition>
        <stop_condition>
          <item>Planner decision artifact emitted for manager re-route.</item>
        </stop_condition>
        <required_artifacts>
          <item>task_intake</item>
          <item>manager_route</item>
          <item>plan_sidecar</item>
          <item>execution_packet</item>
        </required_artifacts>
      </path>
      <path>
        <path_id>verifier_post</path_id>
        <entry_condition>
          <item>Task explicitly demands deterministic verification proof.</item>
        </entry_condition>
        <reject_condition>
          <item>No deterministic checks are defined in acceptance criteria.</item>
        </reject_condition>
        <escalation_condition>
          <item>Verification verdict is fail or inconclusive.</item>
        </escalation_condition>
        <stop_condition>
          <item>Verification verdict pass or managed escalation complete.</item>
        </stop_condition>
        <required_artifacts>
          <item>task_intake</item>
          <item>manager_route</item>
          <item>execution_packet</item>
          <item>verification_result</item>
        </required_artifacts>
      </path>
      <path>
        <path_id>full_lane</path_id>
        <entry_condition>
          <item>Risk critical or high risk combined with ambiguity or explicit verification need.</item>
        </entry_condition>
        <reject_condition>
          <item>Low-risk clear tasks that satisfy direct path conditions.</item>
        </reject_condition>
        <escalation_condition>
          <item>Any lane emits blocker repeatedly beyond retry threshold.</item>
        </escalation_condition>
        <stop_condition>
          <item>Planner and verifier outcomes satisfy route acceptance and stop rules.</item>
          <item>Escalation terminates execution.</item>
        </stop_condition>
        <required_artifacts>
          <item>task_intake</item>
          <item>manager_route</item>
          <item>plan_sidecar</item>
          <item>execution_packet</item>
          <item>verification_result</item>
        </required_artifacts>
      </path>
    </paths>
    <sidecar_execution_mode>conditional_sidecar_artifact_orchestration_batch3_default_off</sidecar_execution_mode>
  </payload>
  <integrity>
    <content_sha256>48477ae61848c73b7b28c75ab325620860f09590c75a3096320f9ad6ac54c6cd</content_sha256>
  </integrity>
</pxml>
