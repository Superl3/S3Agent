  <payload>
    <taxonomy_id>FAIL-TAX-B6-001</taxonomy_id>
    <reasons>
      <reason>
        <taxonomy_id>FAIL-TAX-B6-001</taxonomy_id>
        <code>implementer_rewrite_exception_unapproved</code>
        <category>implementer</category>
        <severity>major</severity>
        <description>Packet requested full rewrite exception without explicit approval or reason.</description>
        <recommended_next_action>Update packet constraints or revert to patch_first execution.</recommended_next_action>
        <escalation_default>false</escalation_default>
      </reason>
      <reason>
        <taxonomy_id>FAIL-TAX-B6-001</taxonomy_id>
        <code>implementer_max_files_exceeded</code>
        <category>implementer</category>
        <severity>major</severity>
        <description>expected_files count exceeded patch_constraints max_files.</description>
        <recommended_next_action>Reduce expected file set or issue approved packet update.</recommended_next_action>
        <escalation_default>false</escalation_default>
      </reason>
      <reason>
        <taxonomy_id>FAIL-TAX-B6-001</taxonomy_id>
        <code>implementer_expected_outside_scope</code>
        <category>implementer</category>
        <severity>blocker</severity>
        <description>Expected file path is outside packet in_scope boundary.</description>
        <recommended_next_action>Regenerate packet with corrected scope mapping.</recommended_next_action>
        <escalation_default>true</escalation_default>
      </reason>
      <reason>
        <taxonomy_id>FAIL-TAX-B6-001</taxonomy_id>
        <code>implementer_out_of_scope_violation</code>
        <category>implementer</category>
        <severity>blocker</severity>
        <description>Expected file collides with packet out_of_scope restriction.</description>
        <recommended_next_action>Adjust expected_files or scope exclusions before retry.</recommended_next_action>
