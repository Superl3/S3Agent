<?xml version="1.0" encoding="UTF-8"?>
<pxml xmlns="urn:pxml:v1">
  <meta>
    <doc_id>doc_escalation_policy_batch4_001</doc_id>
    <doc_class>escalation_policy</doc_class>
    <schema_version>1.0.0</schema_version>
    <task_id>task_harness_batch4_orchestration</task_id>
    <run_id>run_batch4_policies_001</run_id>
    <sequence>1</sequence>
    <writer_agent>manager</writer_agent>
    <created_at>2026-03-22T04:00:00Z</created_at>
  </meta>
  <refs>
    <ref>
      <doc_id>doc_retry_policy_batch4_001</doc_id>
      <doc_class>retry_policy</doc_class>
      <relation>companion_policy</relation>
    </ref>
  </refs>
  <payload>
    <repeated_failure_threshold>3</repeated_failure_threshold>
    <blocker_threshold>1</blocker_threshold>
    <inconclusive_threshold>2</inconclusive_threshold>
    <human_escalation_condition>
      <item>Same failure reason appears beyond repeated_failure_threshold.</item>
      <item>Verifier remains inconclusive after configured retries.</item>
    </human_escalation_condition>
    <stop_after_escalation>true</stop_after_escalation>
    <rules>
      <rule>
        <policy_id>ESC-POL-001</policy_id>
        <escalation_rule_id>esc_repeated_failure</escalation_rule_id>
        <applies_to>
          <item>manager</item>
          <item>coordinator</item>
          <item>all_lanes</item>
        </applies_to>
        <trigger_condition>same_reason_failure_count_at_or_above_threshold</trigger_condition>
        <threshold>3</threshold>
        <escalation_target>human_manager</escalation_target>
        <effect>escalate</effect>
      </rule>
      <rule>
        <policy_id>ESC-POL-002</policy_id>
        <escalation_rule_id>esc_direct_path_guard</escalation_rule_id>
        <applies_to>
          <item>direct</item>
          <item>verifier_post</item>
        </applies_to>
        <trigger_condition>direct_path_escalation_triggered</trigger_condition>
        <threshold>1</threshold>
        <escalation_target>manager</escalation_target>
        <effect>stop</effect>
      </rule>
      <rule>
        <policy_id>ESC-POL-003</policy_id>
        <escalation_rule_id>esc_sidecar_unavailable</escalation_rule_id>
        <applies_to>
          <item>planner_pre</item>
          <item>full_lane</item>
        </applies_to>
        <trigger_condition>sidecar_artifact_generation_failed</trigger_condition>
        <threshold>1</threshold>
        <escalation_target>manager</escalation_target>
        <effect>defer</effect>
      </rule>
    </rules>
  </payload>
  <integrity>
    <content_sha256>99a7dd8185cf3880f59965fd9576bcfd1f2a272728a4d4ad74c37455f2f25dc8</content_sha256>
  </integrity>
</pxml>
