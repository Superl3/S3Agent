<?xml version="1.0" encoding="UTF-8"?>
<pxml xmlns="urn:pxml:v1">
  <meta>
    <doc_id>doc_retry_policy_batch4_001</doc_id>
    <doc_class>retry_policy</doc_class>
    <schema_version>1.0.0</schema_version>
    <task_id>task_harness_batch4_orchestration</task_id>
    <run_id>run_batch4_policies_001</run_id>
    <sequence>1</sequence>
    <writer_agent>manager</writer_agent>
    <created_at>2026-03-22T04:01:00Z</created_at>
  </meta>
  <refs>
    <ref>
      <doc_id>doc_escalation_policy_batch4_001</doc_id>
      <doc_class>escalation_policy</doc_class>
      <relation>companion_policy</relation>
    </ref>
  </refs>
  <payload>
    <same_cause_fast_escalation_threshold>2</same_cause_fast_escalation_threshold>
    <rules>
      <rule>
        <policy_id>RETRY-POL-001</policy_id>
        <retry_rule_id>retry_implementer_blocked</retry_rule_id>
        <applies_to>
          <item>implementer</item>
          <item>blocked</item>
        </applies_to>
        <retry_condition>blocked_with_same_reason_code</retry_condition>
        <max_attempts>2</max_attempts>
        <reset_condition>new_packet_doc_id_or_reason_code_change</reset_condition>
        <next_effect>escalate</next_effect>
      </rule>
      <rule>
        <policy_id>RETRY-POL-002</policy_id>
        <retry_rule_id>retry_reviewer_revise</retry_rule_id>
        <applies_to>
          <item>reviewer</item>
          <item>decision_revise</item>
        </applies_to>
        <retry_condition>review_decision_is_revise</retry_condition>
        <max_attempts>2</max_attempts>
        <reset_condition>decision_changes_to_approve</reset_condition>
        <next_effect>escalate</next_effect>
      </rule>
      <rule>
        <policy_id>RETRY-POL-003</policy_id>
        <retry_rule_id>retry_verifier_inconclusive</retry_rule_id>
        <applies_to>
          <item>verifier</item>
          <item>final_verdict_inconclusive</item>
        </applies_to>
        <retry_condition>verification_result_is_inconclusive</retry_condition>
        <max_attempts>2</max_attempts>
        <reset_condition>final_verdict_changes_to_pass_or_fail</reset_condition>
        <next_effect>escalate</next_effect>
      </rule>
    </rules>
  </payload>
  <integrity>
    <content_sha256>8387df6ab636545a0ea9065f34709e5f0906fd23af6f2a73efd5847346a2f539</content_sha256>
  </integrity>
</pxml>
