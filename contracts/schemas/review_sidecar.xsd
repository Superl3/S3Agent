<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:pxml:v1"
           xmlns="urn:pxml:v1"
           elementFormDefault="qualified">

  <xs:include schemaLocation="../pxml/core_syntax.xsd"/>

  <xs:complexType name="ReviewSidecarRefsType">
    <xs:sequence>
      <xs:element name="ref" type="ReferenceItemType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReviewTargetRefsType">
    <xs:sequence>
      <xs:element name="ref" type="ReferenceItemType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReviewFindingType">
    <xs:sequence>
      <xs:element name="finding_id" type="NonEmptyStringType"/>
      <xs:element name="severity" type="FindingSeverityType"/>
      <xs:element name="message" type="NonEmptyStringType"/>
      <xs:element name="evidence_ref" type="ReferenceItemType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReviewFindingsType">
    <xs:sequence>
      <xs:element name="finding" type="ReviewFindingType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReviewSidecarPayloadType">
    <xs:sequence>
      <xs:element name="review_target_refs" type="ReviewTargetRefsType"/>
      <xs:element name="findings" type="ReviewFindingsType"/>
      <xs:element name="decision" type="ReviewDecisionType"/>
      <xs:element name="blocking_count" type="xs:nonNegativeInteger"/>
      <xs:element name="acceptance_lock_sha256" type="Sha256Type" minOccurs="0"/>
      <xs:element name="recommended_followups" type="StringListType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReviewSidecarDocumentType">
    <xs:sequence>
      <xs:element name="meta" type="MetaType"/>
      <xs:element name="refs" type="ReviewSidecarRefsType"/>
      <xs:element name="payload" type="ReviewSidecarPayloadType"/>
      <xs:element name="integrity" type="IntegrityType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="pxml" type="ReviewSidecarDocumentType"/>

</xs:schema>
