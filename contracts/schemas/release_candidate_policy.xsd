<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:pxml:v1"
           xmlns="urn:pxml:v1"
           elementFormDefault="qualified">

  <xs:include schemaLocation="../pxml/core_syntax.xsd"/>

  <xs:simpleType name="ReleaseCandidateDecisionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pass_requirement"/>
      <xs:enumeration value="warning_allowed"/>
      <xs:enumeration value="fail_requirement"/>
      <xs:enumeration value="require_documentation"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ReleaseCandidatePolicyRuleType">
    <xs:sequence>
      <xs:element name="policy_id" type="NonEmptyStringType"/>
      <xs:element name="rule_name" type="NonEmptyStringType"/>
      <xs:element name="applies_to" type="StringListType"/>
      <xs:element name="trigger_condition" type="NonEmptyStringType"/>
      <xs:element name="decision" type="ReleaseCandidateDecisionType"/>
      <xs:element name="rationale" type="NonEmptyStringType"/>
      <xs:element name="enforcement_level" type="EnforcementLevelType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReleaseCandidatePolicyRuleListType">
    <xs:sequence>
      <xs:element name="rule" type="ReleaseCandidatePolicyRuleType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReleaseCandidatePolicyPayloadType">
    <xs:sequence>
      <xs:element name="policy_name" type="NonEmptyStringType"/>
      <xs:element name="rules" type="ReleaseCandidatePolicyRuleListType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReleaseCandidatePolicyDocumentType">
    <xs:sequence>
      <xs:element name="meta" type="MetaType"/>
      <xs:element name="refs" type="RefsType" minOccurs="0"/>
      <xs:element name="payload" type="ReleaseCandidatePolicyPayloadType"/>
      <xs:element name="integrity" type="IntegrityType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="pxml" type="ReleaseCandidatePolicyDocumentType"/>

</xs:schema>
