<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:pxml:v1"
           xmlns="urn:pxml:v1"
           elementFormDefault="qualified">

  <xs:include schemaLocation="../pxml/core_syntax.xsd"/>

  <xs:simpleType name="RenderReadinessType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ready"/>
      <xs:enumeration value="not_ready"/>
      <xs:enumeration value="caution"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="OperatorPreflightReportPayloadType">
    <xs:sequence>
      <xs:element name="report_id" type="NonEmptyStringType"/>
      <xs:element name="task_id" type="TaskIdType"/>
      <xs:element name="latest_route_ref" type="ReferenceItemType"/>
      <xs:element name="latest_packet_ref" type="ReferenceItemType"/>
      <xs:element name="latest_status_report_ref" type="ReferenceItemType"/>
      <xs:element name="latest_trace_ref" type="ReferenceItemType"/>
      <xs:element name="latest_verification_ref" type="ReferenceItemType" minOccurs="0"/>
      <xs:element name="quarantine_flags" type="StringListType"/>
      <xs:element name="lineage_ok" type="xs:boolean"/>
      <xs:element name="status_ok" type="xs:boolean"/>
      <xs:element name="unresolved_failures" type="StringListType"/>
      <xs:element name="render_readiness" type="RenderReadinessType"/>
      <xs:element name="next_action" type="NonEmptyStringType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OperatorPreflightReportDocumentType">
    <xs:sequence>
      <xs:element name="meta" type="MetaType"/>
      <xs:element name="refs" type="RefsType" minOccurs="0"/>
      <xs:element name="payload" type="OperatorPreflightReportPayloadType"/>
      <xs:element name="integrity" type="IntegrityType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="pxml" type="OperatorPreflightReportDocumentType"/>

</xs:schema>
