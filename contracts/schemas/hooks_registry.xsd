<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:pxml:v1"
           xmlns="urn:pxml:v1"
           elementFormDefault="qualified">

  <xs:include schemaLocation="../pxml/core_syntax.xsd"/>

  <xs:complexType name="HookEntryType">
    <xs:sequence>
      <xs:element name="hook_id" type="NonEmptyStringType"/>
      <xs:element name="source" type="NonEmptyStringType"/>
      <xs:element name="name" type="NonEmptyStringType"/>
      <xs:element name="purpose" type="NonEmptyStringType"/>
      <xs:element name="trigger_phase" type="NonEmptyStringType"/>
      <xs:element name="allowed_agents" type="WriterAgentListType"/>
      <xs:element name="capability_scope" type="CapabilityScopeListType"/>
      <xs:element name="enabled_by_default" type="xs:boolean"/>
      <xs:element name="registry_status" type="RegistryStatusType"/>
      <xs:element name="notes" type="NonEmptyStringType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="HookEntriesType">
    <xs:sequence>
      <xs:element name="hook" type="HookEntryType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="HooksRegistryPayloadType">
    <xs:sequence>
      <xs:element name="source_root" type="NonEmptyStringType"/>
      <xs:element name="entries" type="HookEntriesType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="HooksRegistryDocumentType">
    <xs:sequence>
      <xs:element name="meta" type="MetaType"/>
      <xs:element name="refs" type="RefsType" minOccurs="0"/>
      <xs:element name="payload" type="HooksRegistryPayloadType"/>
      <xs:element name="integrity" type="IntegrityType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="pxml" type="HooksRegistryDocumentType"/>

</xs:schema>
