<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:pxml:v1"
           xmlns="urn:pxml:v1"
           elementFormDefault="qualified">

  <xs:include schemaLocation="../pxml/core_syntax.xsd"/>

  <xs:simpleType name="RunbookDecisionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="allow"/>
      <xs:enumeration value="allow_with_override"/>
      <xs:enumeration value="deny"/>
      <xs:enumeration value="require_logging"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="OperatorRunbookRuleType">
    <xs:sequence>
      <xs:element name="policy_id" type="NonEmptyStringType"/>
      <xs:element name="rule_name" type="NonEmptyStringType"/>
      <xs:element name="applies_to" type="StringListType"/>
      <xs:element name="trigger_condition" type="NonEmptyStringType"/>
      <xs:element name="decision" type="RunbookDecisionType"/>
      <xs:element name="rationale" type="NonEmptyStringType"/>
      <xs:element name="enforcement_level" type="EnforcementLevelType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OperatorRunbookRuleListType">
    <xs:sequence>
      <xs:element name="rule" type="OperatorRunbookRuleType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OperatorRunbookPolicyPayloadType">
    <xs:sequence>
      <xs:element name="policy_name" type="NonEmptyStringType"/>
      <xs:element name="rules" type="OperatorRunbookRuleListType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OperatorRunbookPolicyDocumentType">
    <xs:sequence>
      <xs:element name="meta" type="MetaType"/>
      <xs:element name="refs" type="RefsType" minOccurs="0"/>
      <xs:element name="payload" type="OperatorRunbookPolicyPayloadType"/>
      <xs:element name="integrity" type="IntegrityType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="pxml" type="OperatorRunbookPolicyDocumentType"/>

</xs:schema>
