<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:pxml:v1"
           xmlns="urn:pxml:v1"
           elementFormDefault="qualified">

  <xs:include schemaLocation="../pxml/core_syntax.xsd"/>

  <xs:simpleType name="TaskCurrentPhaseType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="intake"/>
      <xs:enumeration value="routing"/>
      <xs:enumeration value="planning"/>
      <xs:enumeration value="exploring"/>
      <xs:enumeration value="implementing"/>
      <xs:enumeration value="verifying"/>
      <xs:enumeration value="escalated"/>
      <xs:enumeration value="stopped"/>
      <xs:enumeration value="completed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TaskCurrentStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pending"/>
      <xs:enumeration value="running"/>
      <xs:enumeration value="blocked"/>
      <xs:enumeration value="retry_failed"/>
      <xs:enumeration value="escalated"/>
      <xs:enumeration value="passed"/>
      <xs:enumeration value="failed"/>
      <xs:enumeration value="inconclusive"/>
      <xs:enumeration value="no_op"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TaskEscalationStateType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="requested"/>
      <xs:enumeration value="escalated"/>
      <xs:enumeration value="stopped"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FinalVerdictCandidateType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pass"/>
      <xs:enumeration value="fail"/>
      <xs:enumeration value="inconclusive"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TaskProofStatusSummaryType">
    <xs:sequence>
      <xs:element name="structural" type="RequirementStatusType"/>
      <xs:element name="behavioral" type="RequirementStatusType"/>
      <xs:element name="regression" type="RequirementStatusType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TaskRequirementStatusItemType">
    <xs:sequence>
      <xs:element name="requirement" type="NonEmptyStringType"/>
      <xs:element name="proof_method" type="NonEmptyStringType"/>
      <xs:element name="status" type="RequirementStatusType"/>
      <xs:element name="reason" type="NonEmptyStringType" minOccurs="0"/>
      <xs:element name="current_evidence" type="NonEmptyStringType"/>
      <xs:element name="next_recommended_action" type="NonEmptyStringType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TaskRequirementStatusMatrixType">
    <xs:sequence>
      <xs:element name="requirement" type="TaskRequirementStatusItemType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TaskStatusReportPayloadType">
    <xs:sequence>
      <xs:element name="task_id" type="TaskIdType"/>
      <xs:element name="current_phase" type="TaskCurrentPhaseType"/>
      <xs:element name="current_status" type="TaskCurrentStatusType"/>
      <xs:element name="selected_path" type="RoutePathType" minOccurs="0"/>
      <xs:element name="planning_mode" type="PlanningModeType" minOccurs="0"/>
      <xs:element name="execution_shape" type="ExecutionShapeType" minOccurs="0"/>
      <xs:element name="latest_route_ref" type="ReferenceItemType" minOccurs="0"/>
      <xs:element name="latest_packet_ref" type="ReferenceItemType" minOccurs="0"/>
      <xs:element name="latest_exploration_result_ref" type="ReferenceItemType" minOccurs="0"/>
      <xs:element name="latest_implementer_result_ref" type="ReferenceItemType" minOccurs="0"/>
      <xs:element name="latest_verification_ref" type="ReferenceItemType" minOccurs="0"/>
      <xs:element name="latest_trace_ref" type="ReferenceItemType" minOccurs="0"/>
      <xs:element name="acceptance_lock_sha256" type="Sha256Type" minOccurs="0"/>
      <xs:element name="retry_count" type="xs:nonNegativeInteger"/>
      <xs:element name="escalation_state" type="TaskEscalationStateType"/>
      <xs:element name="proof_status" type="TaskProofStatusSummaryType" minOccurs="0"/>
      <xs:element name="requirement_status_matrix" type="TaskRequirementStatusMatrixType" minOccurs="0"/>
      <xs:element name="completion_state" type="CompletionStateType" minOccurs="0"/>
      <xs:element name="final_verdict_candidate" type="FinalVerdictCandidateType"/>
      <xs:element name="next_recommended_action" type="NonEmptyStringType"/>
      <xs:element name="failure_reason_codes" type="StringListType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TaskStatusReportDocumentType">
    <xs:sequence>
      <xs:element name="meta" type="MetaType"/>
      <xs:element name="refs" type="RefsType" minOccurs="0"/>
      <xs:element name="payload" type="TaskStatusReportPayloadType"/>
      <xs:element name="integrity" type="IntegrityType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="pxml" type="TaskStatusReportDocumentType"/>

</xs:schema>
