    <task_id>task_harness_batch3_sidecars</task_id>
    <run_id>run_batch3_contracts_001</run_id>
    <sequence>1</sequence>
    <writer_agent>system</writer_agent>
    <created_at>2026-03-22T01:01:00Z</created_at>
  </meta>
  <refs>
    <ref>
      <doc_id>doc_routing_policy_batch2_001</doc_id>
      <doc_class>routing_policy</doc_class>
      <relation>policy</relation>
    </ref>
    <ref>
      <doc_id>doc_execution_policy_batch2_001</doc_id>
      <doc_class>execution_policy</doc_class>
      <relation>policy</relation>
    </ref>
  </refs>
  <payload>
    <role>Conditional reviewer sidecar that evaluates implementation evidence and produces structured review_sidecar findings.</role>
    <inputs>
      <item>execution_packet artifact</item>
      <item>implementation evidence refs and execution_trace artifacts</item>
      <item>execution_policy constraints</item>
    </inputs>
    <outputs>
      <item>review_sidecar artifact with review_target_refs findings decision blocking_count</item>
      <item>optional recommended followups</item>
    </outputs>
    <must_do>
      <item>Declare review_target_refs including execution_packet reference.</item>
      <item>Produce structured findings with severity and evidence linkage.</item>
      <item>Compute blocking_count deterministically from findings.</item>
      <item>Set decision to approve revise or escalate based on findings.</item>
      <item>Run only when reviewer lane is selected by manager routing.</item>
    </must_do>
    <must_not_do>
      <item>Do not emit freeform-only review without structured findings.</item>
      <item>Do not modify source code or execute patch operations.</item>
      <item>Do not alter acceptance checks or route path definitions.</item>
      <item>Do not perform verification verdict responsibility reserved for Verifier.</item>
      <item>Do not activate or invoke ECC registry assets.</item>
    </must_not_do>
    <failure_handoff>
      <item>Emit decision escalate with blocker findings when review cannot safely approve.</item>
      <item>Emit revise with actionable followups when issues are fixable in current scope.</item>
    </failure_handoff>
    <artifact_responsibilities>
      <item>Write review_sidecar artifacts to runtime/sidecars/reviewer.</item>
      <item>Reference execution_packet and relevant trace or evidence artifacts.</item>
      <item>Do not write execution_packet or verification_result artifacts.</item>
    </artifact_responsibilities>
    <dormant_registry_note>ECC registries remain dormant metadata and are not reviewer execution inputs in Batch 3.</dormant_registry_note>
  </payload>
  <integrity>
    <content_sha256>8f0d92f6c1f15f8eb10b1975b9843f3aac4ff0b39ff4637d061e3c35f7be8c34</content_sha256>
  </integrity>
</pxml>
