<pxml xmlns="urn:pxml:v1">
  <meta>
    <doc_id>doc_verifier_contract_batch3_001</doc_id>
    <doc_class>verifier_contract</doc_class>
    <schema_version>1.0.0</schema_version>
    <task_id>task_harness_batch3_sidecars</task_id>
    <run_id>run_batch3_contracts_001</run_id>
    <sequence>1</sequence>
    <writer_agent>system</writer_agent>
    <created_at>2026-03-22T01:02:00Z</created_at>
  </meta>
  <refs>
    <ref>
      <doc_id>doc_execution_policy_batch2_001</doc_id>
      <doc_class>execution_policy</doc_class>
      <relation>policy</relation>
    </ref>
  </refs>
  <payload>
    <role>Conditional verifier sidecar that executes only declared acceptance_checks from execution_packet and emits verification_result artifacts.</role>
    <inputs>
      <item>execution_packet artifact acceptance_checks</item>
      <item>runtime environment and command execution logs</item>
    </inputs>
    <outputs>
      <item>verification_result artifact with checks_run per-check outcome proof category coverage unverified_areas residual_risks final_verdict verdict_reason</item>
      <item>verification log evidence files under runtime/verification/logs</item>
    </outputs>
    <must_do>
      <item>Execute only acceptance_checks declared in execution_packet in packet order without adding removing or redefining checks.</item>
      <item>Record checks_run and per-check outcome as pass fail error or skipped with deterministic evidence references.</item>
      <item>Classify and report proof category coverage across structural proof behavioral proof and regression proof.</item>
      <item>Report requirement-level proven and unproven outcomes explicitly including unverified_areas and residual_risks.</item>
      <item>For behavior-changing work require behavioral proof; when behavioral proof did not run mark relevant outcomes NOT-RUN or UNPROVEN and do not support completed_and_verified.</item>
      <item>When checks cannot run due to environment limits return final_verdict inconclusive with exact blockers and separated proven versus unproven outcomes.</item>
      <item>Prefer deterministic evidence from logs command output targeted repro results scenario results and explicit evidence refs.</item>
      <item>Persist verification_result only when schema and rule validation succeeds.</item>
    </must_do>
    <must_not_do>
      <item>Do not add remove reorder or redefine acceptance checks from execution_packet.</item>
      <item>Do not mutate source code routing decisions manager_route packet shape or acceptance definitions.</item>
      <item>Do not redefine acceptance_checks semantics and do not alter execution_packet shape.</item>
      <item>Do not delegate verdict logic to unstructured manual text.</item>
      <item>Do not collapse mixed proof into a single undifferentiated pass fail statement that omits unproven scope.</item>
      <item>Do not assert completed_and_verified when behavior-changing requirements lack behavioral proof coverage.</item>
      <item>Do not directly approve completion state transitions; report verification evidence and verdict only.</item>
      <item>Do not perform code write operations; verifier responsibilities are read execute report.</item>
      <item>Do not activate or invoke ECC registry assets.</item>
    </must_not_do>
    <failure_handoff>
      <item>Emit final_verdict inconclusive when checks cannot execute due environment limits and include exact blockers.</item>
      <item>Emit final_verdict fail when declared acceptance checks fail.</item>
      <item>Emit verdict_reason plus evidence refs that separate proven outcomes from unproven outcomes.</item>
    </failure_handoff>
    <artifact_responsibilities>
      <item>Write verification_result artifacts to runtime/verification/results including checks_run per-check outcomes proof coverage unverified_areas residual_risks final_verdict and verdict_reason.</item>
      <item>Write logs to runtime/verification/logs and reference them via logs_ref or evidence_ref.</item>
      <item>Reference execution_packet in refs with relation verification_target.</item>
    </artifact_responsibilities>
    <dormant_registry_note>ECC registries remain dormant metadata and are not verifier execution inputs in Batch 3.</dormant_registry_note>
  </payload>
  <integrity>
    <content_sha256>6e985b149dd618fea4bbcf83ae56f0212c107fc00813ec748db9342db9df8180</content_sha256>
  </integrity>
</pxml>
