{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "manager",
  // Active desktop harness topology is manager -> implementer/planner/verifier.
  // Reviewer remains dormant and is intentionally not wired into runtime permissions.
  // Subagent task delegation is disabled at config level to prevent noop/dead-end
  // subagent calls from manager. Planner/verifier/implementer lanes are orchestrated
  // by runtime scripts (task_executor/coordinator), not direct manager task() handoffs.
  "agent": {
    "default": {
      "mode": "subagent",
      "variant": "auto",
      "reasoningEffort": "auto",
      "textVerbosity": "low"
    },
    "manager": {
      "mode": "primary",
      "description": "Primary entry manager (Manager -> Implementer core path)",
      "prompt": "{file:./agents/manager/contract.pxml}",
      "permission": {
        "*": "deny",
        // Manager handles investigation directly with read/search/shell tools.
        // This prevents noop task() delegation loops when planner/verifier are
        // configured as runtime-script sidecars.
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "shell": "allow",
        "webfetch": "allow",
        "task": {
          "*": "deny"
        }
      }
    },
    "implementer": {
      "mode": "subagent",
      "hidden": true,
      "description": "Single-writer implementer",
      "prompt": "{file:./agents/implementer/contract.pxml}",
      "permission": {
        "*": "deny",
        "task": {
          "*": "deny"
        }
      }
    },
    "planner": {
      "mode": "subagent",
      "hidden": true,
      "description": "Conditional planner sidecar",
      "prompt": "{file:./agents/sidecars/planner/contract.pxml}",
      "permission": {
        "*": "deny",
        "task": {
          "*": "deny"
        }
      }
    },
    "verifier": {
      "mode": "subagent",
      "hidden": true,
      "description": "Conditional verifier sidecar",
      "prompt": "{file:./agents/sidecars/verifier/contract.pxml}",
      "permission": {
        "*": "deny",
        "task": {
          "*": "deny"
        }
      }
    }
  },
  "plugin": [
    "@opencode-ai/plugin@1.2.18"
  ]
}
