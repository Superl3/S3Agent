  <payload>
    <task_summary>bugfix task via verifier_post: Fix retry counter overflow and verify regression coverage.</task_summary>
    <in_scope>
      <item>src/</item>
    </in_scope>
    <out_of_scope>
      <item>docs/</item>
      <item>runtime/</item>
    </out_of_scope>
    <expected_files>
      <file>
        <path>src/target_bugfix.py</path>
        <mode>modify</mode>
      </file>
    </expected_files>
    <patch_constraints>
      <patch_mode>patch_first</patch_mode>
      <max_files>1</max_files>
      <rewrite_exception_approved>false</rewrite_exception_approved>
    </patch_constraints>
    <acceptance_checks>
      <check>
        <check_id>check_bugfix_core_001</check_id>
        <check_type>test</check_type>
        <command>python -m py_compile scripts/pxml_validator.py scripts/packet_builder.py scripts/trace_appender.py</command>
        <pass_condition>exit_code==0</pass_condition>
        <deterministic>true</deterministic>
        <timeout_sec>300</timeout_sec>
      </check>
    </acceptance_checks>
    <acceptance_lock_hash>7994348a46305fb9f15ba34ccb16a2506761f8c3e33ba44d5d54e789c38295eb</acceptance_lock_hash>
    <test_guidance>
      <item>Run acceptance checks in listed order.</item>
      <item>Escalate if deterministic check cannot execute.</item>
    </test_guidance>
    <escalation_triggers>
      <item>Out-of-scope change required for completion.</item>
      <item>Rewrite exception required without approval.</item>
      <item>Sidecar lane selected but unavailable in Batch 2 runtime loop.</item>
    </escalation_triggers>
    <stop_conditions>
      <item>All acceptance checks satisfy pass conditions.</item>
      <item>Escalation trigger is raised.</item>
      <item>Manager emits stop decision.</item>
    </stop_conditions>
    <localization_targets>
      <item>src/target_bugfix.py:target_function</item>
    </localization_targets>
